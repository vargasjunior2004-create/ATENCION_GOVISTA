# === Configuracion de Base de Datos ===
# PostgreSQL (Supabase) — copia el connection string de tu proyecto Supabase
# Ve a: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# === Django ===
DJANGO_SECRET_KEY=tu-secret-key-aqui
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.wasmer.app

# === Opcional: SQLite fallback (solo desarrollo local sin PostgreSQL) ===
# SQLITE_PATH=data/db.sqlite3
